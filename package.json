{
  "name": "lmsdash-browser-extension",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build_contentScript": "rollup --config contentScript.rollup.config.ts",
    "build_manifest": "cp manifest.json dist",
    "build_vite": "vite build",
    "build_app": "npm run build_vite && npm run build_contentScript && npm run build_manifest",
    "build": "NODE_ENV=production npm run build_app",
    "dev": "NODE_ENV=development npm run build_app",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "scan:secrets": "scripts/check-secrets.sh",
    "scan:secrets:all": "scripts/check-secrets.sh --all",
    "validate:build": "node scripts/validate-build.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@types/chrome": "^0.1.27",
    "animate.css": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@js-temporal/polyfill": "^0.5.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "9.1.7",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
